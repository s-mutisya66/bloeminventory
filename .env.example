# Copy these names into Vercel: Project, Settings, Environment Variables.
# Never commit real values to GitHub.

# The username staff type to sign in (not case sensitive)
SHOP_USER=owner

# The password staff type to sign in. Use something long and unique.
SHOP_PASSWORD=change-this-to-a-long-unique-password

# A long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
# or, with Node:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-the-64-character-random-string-here

# Your Neon connection string (neon.com, project dashboard, Connect).
# If you connect Neon from the Vercel Storage tab, Vercel adds this for you.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
